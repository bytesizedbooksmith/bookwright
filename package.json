{
  "name": "byte-sized-book-formatter",
  "version": "1.3.0",
  "private": true,
  "description": "Byte-Sized Book Formatter — a Markdown book formatter that turns manuscripts into publish-ready ebooks (EPUB) and print PDFs, plus DOCX & Markdown. Local web app with live preview.",
  "author": "Angie Hartwell (Byte-Sized Booksmith)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "cross-env BOOK_FORMATTER_DEV=1 tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "npm run build && tsx server/index.ts",
    "blues": "tsx server/cli-blues.ts",
    "test": "tsx tests/run-all.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "multer": "^1.4.5-lts.1",
    "open": "^10.1.0",
    "pagedjs": "^0.4.3",
    "puppeteer": "^23.11.1",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
