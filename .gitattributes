# Normalize text files to LF in the repo (consistent across Windows/macOS/Linux).
* text=auto eol=lf

# Keep Windows batch files as CRLF.
*.bat text eol=crlf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.epub binary
